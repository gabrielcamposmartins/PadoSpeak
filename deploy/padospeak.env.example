# /etc/padospeak/padospeak.env — variáveis lidas pelo serviço systemd (sobrescrevem o painel).
SERVER_NAME=PadoSpeak
PORT=3000
HOST=0.0.0.0
# off | self-signed | custom
HTTPS=self-signed
# TLS_CERT=/etc/letsencrypt/live/chat.exemplo.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/chat.exemplo.com/privkey.pem
ALLOW_REGISTRATION=true
ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]

# Banco (padrão: arquivo local em /var/lib/padospeak/padospeak.db)
# DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=...
# TURSO_SYNC_URL=libsql://seu-banco.turso.io   # réplica embarcada (arquivo local + sync)

# Painel "Hostear" na rede (sem senha ele só abre em 127.0.0.1)
# PANEL=true
# PANEL_HOST=0.0.0.0
# PANEL_PORT=3001
# PANEL_PASSWORD=troque-esta-senha
