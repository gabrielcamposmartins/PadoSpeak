[Unit]
Description=PadoSpeak - servidor de chat/voz (clone do Discord)
After=network-online.target
Wants=network-online.target

[Service]
User=padospeak
Group=padospeak
Environment=DATA_DIR=/var/lib/padospeak
EnvironmentFile=-/etc/padospeak/padospeak.env
ExecStart=/usr/local/bin/padospeak-server --headless
Restart=on-failure
RestartSec=3
# Permite usar portas < 1024 (ex.: 443) sem rodar como root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/padospeak

[Install]
WantedBy=multi-user.target
